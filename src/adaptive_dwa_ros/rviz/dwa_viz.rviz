
Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz/Grid
      Name: Grid
    - Class: rviz/TF
      Name: TF
  Global Options:
    Fixed Frame: odom
  Views:
    Current:
      Class: rviz/Orbit
      Target Frame: <Fixed Frame>



