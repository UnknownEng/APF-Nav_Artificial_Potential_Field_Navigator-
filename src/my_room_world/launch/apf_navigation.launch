<launch>
  <arg name="gui" default="true"/>

  <!-- Gazebo room + hector quadrotor with Hokuyo UTM-30LX -->
  <include file="$(find my_room_world)/launch/room.launch">
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <!-- APF 3D obstacle-avoidance navigator.
       After launch, enable motors:  rosservice call /enable_motors "{enable: true}" -->
  <node pkg="my_room_world" type="apf_navigator.py" name="apf_navigator" output="screen">
    <param name="start_delay"   value="8.0"/>
    <param name="control_rate"  value="10.0"/>
    <param name="goal_tol_xy"   value="0.6"/>
    <param name="goal_tol_z"    value="0.4"/>
    <param name="v_max"         value="0.3"/>
    <param name="w_max"         value="0.8"/>
    <param name="vz_max"        value="0.3"/>
    <param name="vz_min"        value="-0.3"/>
    <param name="wp_timeout"    value="120.0"/>
    <!-- Face the current waypoint so the 270 deg lidar looks where the drone
         is mostly going (goal | travel | fixed). -->
    <param name="heading_mode" value="goal"/>
    <!-- The lidar mount (upside down on the hector quadrotor) is read from TF.
         scan_yaw_offset overrides it for an UPRIGHT lidar only:
    <param name="scan_yaw_offset" value="0.0"/> -->
  </node>
</launch>
