<launch>
  <arg name="world" default="$(find my_room_world)/worlds/room_6x6.world"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="gui"          value="true"/>
    <arg name="paused"       value="false"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <!-- Spawn in NW corner — clear of all obstacles -->
  <include file="$(find hector_quadrotor_gazebo)/launch/spawn_quadrotor.launch">
    <arg name="model" value="$(find hector_quadrotor_description)/urdf/quadrotor_hokuyo_utm30lx.gazebo.xacro"/>
    <arg name="x" value="-10.0"/>
    <arg name="y" value="10.0"/>
    <arg name="z" value="0."/>
  </include>

  <!--
  APF 3D Obstacle Avoidance Node (disabled). Use apf_navigation.launch instead.
  <node pkg="my_room_world"
        type="dwa_inspection.py"
        name="dwa_inspection"
        output="screen">
    <param name="start_delay"   value="8.0"/>
    <param name="control_rate"  value="10.0"/>
    <param name="goal_tol_xy"   value="0.6"/>
    <param name="goal_tol_z"    value="0.4"/>
    <param name="v_max"         value="0.4"/>
    <param name="v_min"         value="0.0"/>
    <param name="w_max"         value="0.8"/>
    <param name="vz_max"        value="0.3"/>
    <param name="vz_min"        value="-0.3"/>
  </node>
  -->

</launch>
